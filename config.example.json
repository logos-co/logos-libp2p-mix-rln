{
  "addrs": ["/ip4/0.0.0.0/tcp/9100"],
  "transport": "tcp",
  "maxConnections": 50,
  "maxConnsPerPeer": 2,

  "mix": {
    "allowSend": false,
    "allowExit": false,
    "cover": { "rateFraction": 0.7 }
  },

  "rln": {
    "keystorePath": "./keystore.json",
    "keystorePassword": "changeme",
    "treePath": "./rln-tree",
    "rlnResourcesPath": "./rln-resources",
    "epochDurationSeconds": 1,
    "maxEpochGap": 20,
    "userMessageLimit": 100,
    "membershipContentTopic": "/mix/rln/membership/v1",
    "proofMetadataContentTopic": "/mix/rln/metadata/v1"
  }
}
